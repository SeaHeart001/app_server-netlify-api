MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Optional: SSE publish hardening. Defaults to JWT_SECRET when omitted.
SSE_PUBLISH_SECRET=
SSE_EDGE_URL=

# Optional: Ably API key. When set, SSE events are broadcast through the Ably
# global backbone to every Edge isolate that holds connections, fixing message
# loss caused by per-isolate in-memory channel state. Falls back to the legacy
# HTTP publish path when omitted.
ABLY_API_KEY=your-ably-api-key

# Optional: delivery ACK wait window in seconds. After an SSE push, the
# background task waits this long for the client to acknowledge the message
# (readAt written or deliveryState marked) before falling back to the WeChat
# subscribe message. Default 5.
DELIVERY_ACK_WAIT_SECONDS=5

# WeChat Mini Program. Keep these only on the backend.
WX_APP_ID=wx-your-mini-program-appid
WX_APP_SECRET=your-mini-program-secret

# Gitee image upload token. Keep this only on the backend.
GITEE_ACCESS_TOKEN=your-gitee-access-token

# Optional: comma-separated DNS servers for local networks that refuse MongoDB Atlas SRV lookups.
DNS_SERVERS=8.8.8.8,1.1.1.1
